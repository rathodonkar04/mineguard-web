# Copy to .env for local use. Do not commit real credentials.
PORT=5000
DB_ENABLED=false
# Set true with a database for durable telemetry/users; then run node backend/db/init.js.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mineguard
DB_SSL=false
# Blank means same-origin in production, localhost:5000 in development.
VITE_BACKEND_URL=
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
# Use an absolute persistent disk path in hosted deployments.
CAMERA_STORAGE_DIR=./backend/storage/camera
CAMERA_MAX_IMAGES=100
# Optional; if set the camera must send this value in X-Camera-Token.
CAMERA_UPLOAD_TOKEN=
