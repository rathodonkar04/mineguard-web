# MineGuard Backend Environment Configuration
PORT=5000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration
DB_ENABLED=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mineguard
# Or explicit credentials:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mineguard
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_SSL=false

# Alert Notification & Dispatch Configuration
ALERT_DISPATCH_ENABLED=false
ALERT_DISPATCH_MODE=simulation   # 'simulation' | 'live'
ALERT_COOLDOWN_SECONDS=300       # 5 minutes suppression window
ALERT_ESCALATION_TIMEOUT_SECONDS=600 # 10 minutes to level 2

# SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@mineguard-monitoring.gov.in
SMTP_PASS=placeholder-secret
SMTP_FROM="MineGuard Safety Center <alerts@mineguard-monitoring.gov.in>"
ALERT_EMAIL_RECIPIENTS=safety_officer@moonidih.cil.in

# SMS Gateway Configuration (Twilio / Fast2SMS / Mock)
SMS_PROVIDER=mock                # 'mock' | 'twilio' | 'fast2sms'
TWILIO_ACCOUNT_SID=placeholder-sid
TWILIO_AUTH_TOKEN=placeholder-token
TWILIO_FROM_PHONE=+10000000000
ALERT_SMS_RECIPIENTS=+919800000001

